# =====================================================
#  AuraLib API - Variables de entorno (ejemplo)
# =====================================================
# Copia este archivo a `.env` y completa los valores.

# --- Servidor ---
PORT=3100
# Lista separada por comas de orígenes extra CORS (sólo si necesitas browser frontends de QA).
# Por defecto se permiten apps móviles (sin Origin) y localhost.
CORS_ORIGINS=

# --- Cifrado de tokens (REQUERIDO en producción) ---
# Hex de 64 chars (32 bytes). Genera uno con: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
TOKEN_ENCRYPTION_KEY=

# --- Firebase Admin ---
# Opción 1: pega el JSON completo del Service Account (escapa los \n del privateKey).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opción 2: usa Application Default Credentials.
FIREBASE_PROJECT_ID=

# --- Qobuz Secret Extractor (Puppeteer) ---
# Path al binario de Chrome/Chromium para puppeteer-core.
PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Credenciales de respaldo para extraer el bundle Qobuz cuando ningún usuario tiene cuenta válida.
QOBUZ_FALLBACK_EMAIL=
QOBUZ_FALLBACK_PASSWORD=

# --- Last.fm ---
# Clave global por defecto (cada usuario puede sobreescribirla en Settings).
LASTFM_API_KEY=

# --- MusicBrainz ---
# Recomendado por la política de uso de MusicBrainz.
MUSICBRAINZ_USER_AGENT=AuraLib/0.1 (contact@example.com)
