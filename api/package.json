{
  "name": "auralib-api",
  "private": true,
  "version": "0.1.0",
  "description": "Backend de AuraLib: cuentas Firebase, integración Qobuz/Last.fm/MusicBrainz y resolución de URLs streameables.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-fastify": "^10.4.22",
    "fast-xml-parser": "^5.7.2",
    "fastify": "4.28.1",
    "firebase-admin": "^13.8.0",
    "puppeteer-core": "^24.42.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/node": "20.14.12",
    "tsx": "4.16.2",
    "typescript": "5.5.4"
  }
}
